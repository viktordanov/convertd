{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rs-convert.invalid/corpus/expected.schema.json",
  "title": "rs-convert corpus expectations, schema version 1",
  "description": "What the service must answer for each corpus file and option set (ledger item 005, plan section 4). Paths are relative to the directory that holds expected.json: corpus/ for the public corpus, CORPUS_PRIVATE_DIR for the private one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "listener", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": {
      "description": "The environment the generated SHA-256 values were recorded in. Deflate output depends on the zlib build.",
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "zlib", "platform"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "zlib": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "listener": {
      "description": "host:port of the canary listener. The service must not bind it.",
      "type": "string",
      "pattern": "^[0-9.]+:[0-9]{1,5}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "origin", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": {
          "description": "Relative path with forward slashes, under out/ or fixtures/ for the public corpus. validate also rejects . and .. components.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "origin": { "enum": ["generated", "derived", "fixture", "hostile", "private"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "unhashed": {
          "description": "Why a generated file has no stable SHA-256.",
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "source"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "url": { "type": "string" },
            "notice": { "type": "string" }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["smoke", "bench", "fonts", "pages", "blank", "macros", "passwords", "formats",
                     "render", "images", "security", "hostile", "limits"]
          }
        },
        "notes": { "type": "string" },
        "preflight": { "$ref": "#/$defs/preflight" },
        "cases": {
          "description": "Required for every origin except fixture: a fixture is an input of the generator, never sent to the service.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "fixture" } } },
          "then": {
            "required": ["sha256", "licence"],
            "not": { "required": ["cases"] },
            "properties": { "path": { "pattern": "^fixtures/" } }
          },
          "else": { "required": ["cases"] }
        },
        {
          "if": { "properties": { "origin": { "enum": ["generated", "hostile", "derived"] } } },
          "then": {
            "oneOf": [{ "required": ["sha256"] }, { "required": ["unhashed"] }],
            "properties": { "path": { "pattern": "^out/" } }
          }
        },
        { "not": { "required": ["sha256", "unhashed"] } }
      ]
    },
    "preflight": {
      "description": "What 001's scanners must read from the bytes alone, with no engine. Absent for PDFs, images and hostile files. null means the scan does not apply (or cannot run, as on an encrypted package); an empty list means it ran and found nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "encrypted", "declared_pages", "requested_fonts", "macros"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "encrypted": { "type": "boolean" },
        "declared_pages": {
          "description": "V1: visible slides in the PPTX family; null elsewhere.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "hidden_slides": { "type": "integer", "minimum": 0 },
        "requested_fonts": {
          "description": "V2: requested Latin families after theme resolution, sorted.",
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        },
        "macros": {
          "description": "V4: what the macro scan finds.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "part"],
            "properties": {
              "kind": { "enum": ["vba", "xlm", "basic", "script"] },
              "part": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "options", "expect"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "options": {
          "description": "Sent as the options part, as is. The API spec validates it.",
          "type": "object"
        },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "page_count": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "description": "Not typed in yet: check prints the observed value for review.",
          "const": "unrecorded"
        }
      ]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "oneOf": [
            { "$ref": "#/$defs/status" },
            { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/status" } }
          ]
        },
        "code": {
          "description": "The error code (api/openapi.yaml ErrorCode) when the status is not 200.",
          "enum": ["BAD_REQUEST", "UNAUTHORIZED", "NOT_FOUND", "FILE_TOO_LARGE", "UNSUPPORTED_FORMAT",
                   "VALIDATION_ERROR", "PASSWORD_REQUIRED", "INVALID_PASSWORD", "LIMIT_EXCEEDED",
                   "CONVERSION_FAILED", "TOO_MANY_REQUESTS", "INTERNAL_ERROR", "SERVICE_UNAVAILABLE",
                   "CONVERSION_TIMEOUT"]
        },
        "format": { "type": "string", "minLength": 1 },
        "family": { "enum": ["document", "presentation", "spreadsheet", "pdf", "image"] },
        "encrypted": { "type": "boolean" },
        "pdf_origin": { "enum": ["converted", "passthrough", "assembled"] },
        "page_count": { "$ref": "#/$defs/page_count" },
        "warning_count": {
          "description": "Convert-Warning-Count, for output=pdf cases, which carry no manifest.",
          "type": "integer",
          "minimum": 0
        },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "warnings_mode": { "enum": ["exact", "contains"], "default": "exact" },
        "blank_pages": {
          "description": "The pages whose manifest entry has blank: true; every other page has false.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "connections": {
          "description": "Connections the canary listener may see during the case.",
          "const": 0
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": 200 } } },
          "then": { "not": { "required": ["code"] } },
          "else": { "required": ["code"] }
        }
      ]
    },
    "warning": {
      "description": "Matched as a multiset on (code, page); detail is matched as a subset, and \"*\" matches any value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["FONT_SUBSTITUTED", "PAGE_COUNT_MISMATCH", "BLANK_PAGE", "MACROS_IGNORED", "RENDER_CLAMPED"]
        },
        "page": { "type": "integer", "minimum": 1 },
        "detail": { "type": "object" },
        "unless_installed": {
          "description": "Drop this warning when /v1/capabilities lists every family here.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
